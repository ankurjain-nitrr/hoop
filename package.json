{
  "name": "hoop",
  "version": "0.1.0",
  "description": "Humans in the loop: review agent decisions like code",
  "type": "module",
  "bin": {
    "hoop": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "schemas"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build && node scripts/setup-hooks.mjs",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "e2e:docs": "tsx scripts/e2e-docs.ts",
    "e2e:pages": "tsx scripts/e2e-pages.ts",
    "lint": "biome check src web test scripts",
    "format": "biome format --write src web test scripts",
    "schemas": "tsx scripts/schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.0",
    "axe-core": "4.13.0",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "license": "Apache-2.0"
}

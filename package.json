{
  "name": "@ankurjain-nitrr/hoop",
  "version": "1.6.0",
  "description": "Humans in the loop: review agent decisions like code",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankurjain-nitrr/hoop.git"
  },
  "homepage": "https://github.com/ankurjain-nitrr/hoop#readme",
  "type": "module",
  "bin": {
    "hoop": "dist/bin.js"
  },
  "files": [
    "dist",
    "web",
    "schemas"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"for (const f of ['dist/bin.js', 'dist/cli.js']) require('node:fs').chmodSync(f, 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build && node scripts/setup-hooks.mjs",
    "prepublishOnly": "npm run build",
    "bench": "tsx scripts/bench.ts",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "e2e:docs": "tsx scripts/e2e-docs.ts",
    "e2e:pages": "tsx scripts/e2e-pages.ts",
    "eval": "tsx scripts/evals/run.ts",
    "lint": "biome check src web test scripts",
    "format": "biome format --write src web test scripts",
    "schemas": "tsx scripts/schemas.ts",
    "check:package": "npm run build && publint run --strict",
    "check:version": "tsx scripts/version.ts --check",
    "version": "tsx scripts/version.ts",
    "debt": "tsx scripts/debt.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "acorn": "8.19.0",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.0",
    "fast-check": "4.10.2",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "mermaid": "12.2.0",
    "playwright-core": "1.64.1",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "type-coverage": "2.30.4",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}

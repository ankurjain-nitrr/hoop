{
  "name": "@ankurjain-nitrr/hoop",
  "version": "0.2.0",
  "description": "Humans in the loop: review agent decisions like code",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankurjain-nitrr/hoop.git"
  },
  "homepage": "https://github.com/ankurjain-nitrr/hoop#readme",
  "type": "module",
  "bin": {
    "hoop": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "schemas"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepare": "npm run build && node scripts/setup-hooks.mjs",
    "prepublishOnly": "npm run build",
    "e2e:local": "tsx scripts/e2e-local.ts",
    "e2e:docs": "tsx scripts/e2e-docs.ts",
    "e2e:pages": "tsx scripts/e2e-pages.ts",
    "eval": "tsx scripts/evals/run.ts",
    "lint": "biome check src web test scripts",
    "format": "biome format --write src web test scripts",
    "schemas": "tsx scripts/schemas.ts",
    "check:package": "npm run build && publint run --strict",
    "debt": "tsx scripts/debt.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.5",
    "axe-core": "4.14.0",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "mermaid": "12.2.0",
    "playwright-core": "1.64.1",
    "publint": "0.3.25",
    "tsx": "4.23.15",
    "type-coverage": "2.30.4",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

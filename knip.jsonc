// Unused files, exports and dependencies, which `npm run debt` counts against debt-baseline.json.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The CLI, the scripts people run, the tests, and the page modules web/index.html and the diagram frame load.
  "entry": ["src/cli.ts", "scripts/*.{ts,mjs}", "!scripts/lib.ts", "scripts/evals/run.ts", "test/**/*.test.ts", "web/{app,review,select,trail,diagram-frame}.js"],
  "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}", "test/**/*.ts", "web/*.js"],
  // The pages import each other by their served paths ("/app.js").
  "paths": { "/*": ["./web/*"] },
  // test/pages.test.ts resolves axe-core's file by path; scripts/debt.ts runs the others through npx.
  "ignoreDependencies": ["axe-core", "dependency-cruiser", "jscpd", "type-coverage"]
}

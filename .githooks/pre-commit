#!/bin/sh
# Runs before each commit in a contributor's clone: the type check and Biome on staged code. Set up
# by scripts/setup-hooks.mjs.
set -e
staged=$(git diff --cached --name-only --diff-filter=ACMR)
code=$(printf '%s\n' "$staged" | grep -E '^(src|web|test|scripts)/.*\.(ts|js|mjs|css|json)$' || true)

npx tsc --noEmit
if [ -n "$code" ]; then
  # shellcheck disable=SC2086
  npx biome check --no-errors-on-unmatched $code
fi

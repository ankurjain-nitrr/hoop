{
  "$id": "https://github.com/ankurjain-nitrr/hoop/schemas/feedback.schema.json",
  "title": "hoop/feedback@0: a review of a document",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "hoop/feedback@0",
      "description": "The format and its version"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "description": "The review this feedback is on"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "The revision it was given on"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "comment",
        "approved",
        "changes_requested"
      ],
      "description": "The verdict that counts; see agent_approval"
    },
    "summary": {
      "description": "An overall comment, or an approval's notes",
      "type": "string"
    },
    "comments": {
      "default": [],
      "description": "Comments and replies",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thread": {
            "description": "The thread a reply belongs to; leave out for a new comment",
            "type": "string"
          },
          "item": {
            "type": "string",
            "minLength": 1,
            "description": "The item's ID, or DOC for the title and TL;DR"
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "The line, from 1; 0 is the item's heading, and DOC line 1 is the title and 2 the TL;DR"
          },
          "range": {
            "description": "The words the comment is about, inside the line",
            "type": "object",
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991,
                "description": "The first character, from 0"
              },
              "end": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "One past the last character"
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "description": "The exact text from start to end"
              }
            },
            "required": [
              "start",
              "end",
              "quote"
            ]
          },
          "body": {
            "description": "The comment's text",
            "type": "string"
          },
          "suggestion": {
            "description": "Replacement text for the range, or for the whole line",
            "type": "string"
          }
        },
        "required": [
          "item",
          "line"
        ]
      }
    },
    "answers": {
      "default": [],
      "description": "Answers to questions: each question's ID and the chosen option",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1
          },
          "choice": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item",
          "choice"
        ]
      }
    },
    "resolved_threads": {
      "default": [],
      "description": "Threads this feedback resolves",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "viewed": {
      "default": [],
      "description": "Items the reviewer marked as viewed",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "description": "Who gave it, as they named themselves"
    },
    "at": {
      "type": "string",
      "minLength": 1,
      "description": "When, as an ISO 8601 time"
    },
    "signed_in": {
      "description": "The person's GitHub login, when the verdict came with their sign-in in the browser",
      "type": "object",
      "properties": {
        "login": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "login"
      ]
    },
    "unverified": {
      "description": "True for a verdict given with the sign-in turned off in the person's own settings",
      "type": "boolean"
    },
    "agent_approval": {
      "description": "True for an approve sent without a sign-in: stored as a comment, so it never freezes the review",
      "type": "boolean"
    },
    "changes_requested_by_agent": {
      "description": "True for a request for changes sent without a sign-in, stored as a comment",
      "type": "boolean"
    },
    "source": {
      "description": "Where it came from: the local page, or a GitHub pull request review",
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "local",
            "github"
          ]
        },
        "pr": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "review_id": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "comment_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "channel"
      ]
    }
  },
  "required": [
    "schema",
    "review_id",
    "revision",
    "verdict",
    "reviewer",
    "at"
  ]
}
